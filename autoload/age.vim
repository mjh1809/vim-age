" autoload/age.vim - implementation for plugin/age.vim
" This code was generated by Claude (Anthropic's AI assistant).

let s:helper = expand('<sfile>:p:h:h') . '/python/age_pin.py'

function! s:Error(msg) abort
  echohl ErrorMsg | echomsg a:msg | echohl None
endfunction

" Never let plaintext leak to disk via swap/undo/backup/viminfo.
function! s:Harden() abort
  setlocal noswapfile noundofile nobackup nowritebackup
  if g:age_disable_viminfo
    set viminfo=
  endif
endfunction

" systemlist() through pipes: with 'shelltemp' on, Vim would write the
" plaintext to a temp file. The user's setting is restored afterwards.
function! s:System(cmd, input) abort
  let save = &shelltemp
  set noshelltemp
  try
    return systemlist(a:cmd, a:input)
  finally
    let &shelltemp = save
  endtry
endfunction

" Decrypt a file with the YubiKey. Returns the plaintext lines, or v:null on
" failure or cancel (after reporting the error).
function! s:Decrypt(file) abort
  if !filereadable(g:age_identity)
    call s:Error('age: identity not readable: ' . g:age_identity)
    return v:null
  endif
  let pin = inputsecret('YubiKey PIN: ')
  redraw
  if pin ==# ''                 " empty input / <Esc> cancels
    call s:Error('age: cancelled')
    return v:null
  endif
  echo 'Touch the YubiKey...'
  let cmd = join(map([g:age_python, '-I', s:helper, g:age_identity, a:file,
        \ string(g:age_timeout)], 'shellescape(v:val)'))
  let lines = s:System(cmd, pin . "\n")
  let pin = ''
  redraw
  if v:shell_error
    call s:Error('age: decryption failed: ' . join(lines, ' '))
    return v:null
  endif
  return lines
endfunction

" BufReadCmd: :edit file.age
function! age#Read(file) abort
  call s:Harden()
  " Detect filetype from the inner name, e.g. notes.md.age -> markdown.
  if exists('#filetypedetect#BufRead')
    execute 'doautocmd filetypedetect BufRead ' . fnameescape(fnamemodify(a:file, ':r'))
  endif

  if !filereadable(a:file)
    echo '"' . fnamemodify(a:file, ':~:.') . '" [New age file]'
    return
  endif

  let lines = s:Decrypt(a:file)
  if lines is v:null
    " Don't let an empty buffer be written over the encrypted original.
    setlocal nomodifiable
    return
  endif

  let ul = &undolevels
  setlocal undolevels=-1        " don't allow undoing back to an empty buffer
  call setline(1, lines)
  let &l:undolevels = ul
  setlocal nomodified
  echo '"' . fnamemodify(a:file, ':~:.') . '" [age] ' . len(lines) . 'L'
endfunction

" FileReadCmd: :read file.age inserts the decrypted text below the cursor.
function! age#ReadInto(file) abort
  call s:Harden()
  if !filereadable(a:file)
    call s:Error('age: cannot read ' . a:file)
    return
  endif
  let lines = s:Decrypt(a:file)
  if lines isnot v:null
    call append(line("'["), lines)
  endif
endfunction

" BufWriteCmd / FileWriteCmd: encrypt lines first..last to the recipients.
function! age#Write(file, first, last) abort
  call s:Harden()
  " Encryption only needs the public recipients, not the identity.
  if !filereadable(g:age_recipients_file)
    call s:Error('age: recipients file not readable: ' . g:age_recipients_file)
    return
  endif

  let whole = a:first == 1 && a:last == line('$')
  let text = join(getline(a:first, a:last), "\n")
  if !whole || &eol || &fixeol
    let text .= "\n"
  endif

  " Encrypt to a temp file first so a failure can't clobber the original.
  let tmp = a:file . '.tmp~'
  let cmd = 'age -e -R ' . shellescape(g:age_recipients_file) . ' -o ' . shellescape(tmp)
  let out = s:System(cmd, text)
  if v:shell_error || rename(tmp, a:file) != 0
    call delete(tmp)
    call s:Error('age: encryption failed: ' . join(out, ' '))
    return
  endif

  if whole && a:file ==# expand('%:p')
    setlocal nomodified
  endif
  echo '"' . fnamemodify(a:file, ':~:.') . '" [age] ' . (a:last - a:first + 1) . 'L written'
endfunction

" FileAppendCmd: appending plaintext to an age file would corrupt it.
function! age#AppendRefused(file) abort
  call s:Error('age: appending to an encrypted file is not supported: ' . a:file)
endfunction
