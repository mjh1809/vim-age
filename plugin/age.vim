" age.vim - transparently edit age-encrypted files (*.age)
" This code was generated by Claude (Anthropic's AI assistant).
" See :help age

if exists('g:loaded_age') || &compatible || v:version < 800
  finish
endif
let g:loaded_age = 1

" YubiKey identity file (AGE-PLUGIN-YUBIKEY-...). Not secret: it only names
" the YubiKey serial and slot. The default is a placeholder: set your own
" path in your vimrc. Create the file with
"   age-plugin-yubikey --identity > ~/.age/yubikey-identity.txt
let g:age_identity = get(g:, 'age_identity', expand('~/.age/yubikey-identity.txt'))

" Recipients file used for every write (one recipient per line, # comments).
" The default is a placeholder: set your own path in your vimrc.
let g:age_recipients_file = get(g:, 'age_recipients_file', expand('~/.age/recipients.txt'))

" Seconds to wait for the PIN to be accepted and the YubiKey touched.
let g:age_timeout = get(g:, 'age_timeout', 60)

" Python interpreter used for the PIN helper.
let g:age_python = get(g:, 'age_python', 'python3')

" Clear 'viminfo' for the whole session once an age file is opened, so
" registers/history holding plaintext are not written to ~/.viminfo.
let g:age_disable_viminfo = get(g:, 'age_disable_viminfo', 1)

augroup age_encrypted
  autocmd!
  autocmd BufReadCmd   *.age call age#Read(expand('<afile>:p'))
  autocmd FileReadCmd  *.age call age#ReadInto(expand('<afile>:p'))
  autocmd BufWriteCmd  *.age call age#Write(expand('<afile>:p'), 1, line('$'))
  autocmd FileWriteCmd *.age call age#Write(expand('<afile>:p'), line("'["), line("']"))
  autocmd FileAppendCmd *.age call age#AppendRefused(expand('<afile>:p'))
augroup END
